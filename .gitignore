# macOS
.DS_Store
._*

# Editor / IDE
.vscode/
.idea/
*.swp

# Original archive (redundant; unpacked into scaife/)
scaife/*.zip

# Writable runtime working tree (sentinels, ATLAS DB, CTS metadata stubs).
# Regenerated by bootstrap.sh.
sv-data/

# Perseus text corpora (~737 MB, CC BY-SA 4.0). Each corpus is a copy of a
# PerseusDL/* repo (with its own .git/ history); treat as external data,
# not code. Remove this line if you want to check them into your fork.
data-sources/

# Cloned upstream repos — regenerable, and each has its own .git/ history.
# Track only the local Dockerfile I added to build Morpheus for arm64.
deps/*
!deps/morpheus-combined/
deps/morpheus-combined/*
!deps/morpheus-combined/Dockerfile

# Language / build artifacts (defense-in-depth if any wander in from deps
# or the main app tree). The main app has its own .gitignore too.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.venv/
venv/
*.log

# Secrets / local config
**/deploy/.env
**/deploy/.env.local
.env
.envrc

# Docker Compose caches (if the daemon ever writes locally)
.docker/
