# Local hardening layer on top of the untouched upstream Dockerfile.
# The upstream image is built first (see bootstrap.sh) and tagged
# scaife-viewer-base:latest, then this Dockerfile adds:
#   1. a non-root `scaife` user (chown of /opt/scaife-viewer + /sv-data)
#   2. iptables + su-exec, and a launcher (`entrypoint-locked.sh`) that:
#        - sets outbound firewall rules blocking non-Docker traffic
#        - then drops privileges to `scaife` and execs the standard entrypoint
#
# The compose override runs this image with `user: "0"` + cap_add: NET_ADMIN
# so the launcher can set iptables at boot. Immediately after, it su-execs
# to scaife — gunicorn itself never runs as root.
#
# Overridable base tag lets you point at a different upstream if desired:
#   docker build --build-arg UPSTREAM_TAG=my/other:tag ...
ARG UPSTREAM_TAG=scaife-viewer-base:latest
FROM ${UPSTREAM_TAG}

USER root
RUN apk add --no-cache iptables su-exec \
 && adduser -D -u 1000 -H -h /opt/scaife-viewer scaife \
 && mkdir -p /sv-data \
 && chown -R scaife:scaife /opt/scaife-viewer /sv-data

COPY deploy/entrypoint-locked.sh /entrypoint-locked.sh
RUN chmod +x /entrypoint-locked.sh

# Default USER is scaife; the compose override sets `user: "0"` so the
# launcher can call iptables, then drops back to scaife via su-exec.
USER scaife
